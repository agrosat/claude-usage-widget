# Ignora tudo por padrao.
*

# Permite que o Git percorra os diretorios.
!*/

# Metadados do repositorio.
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/requirements.txt

# Codigo-fonte do widget e da statusline.
!/statusline.ps1
!/statusline.py
!/run-python.cmd
!/widget.pyw
!/iniciar-widget.vbs

# Prints usados no README e o script que os gera.
!/docs/*.png
!/docs/gerar_prints.py

# Nunca versionar (dados locais: caminhos, session_id, custo).
usage.json
history.jsonl
last_input.json
widget.json
*.tmp
__pycache__/
NOTAS-GITHUB.md
